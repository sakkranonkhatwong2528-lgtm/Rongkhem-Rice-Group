rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /members/{id}       { allow read: if signedIn(); allow write: if isAdmin(); }
    match /funerals/{id}      { allow read: if signedIn(); allow write: if isAdmin(); }
    match /riceRecords/{id}   { allow read: if signedIn(); allow write: if isAdmin(); }
    match /announcements/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /config/{id}        { allow read: if signedIn(); allow write: if isAdmin(); }
    match /activityLog/{id}   { allow read: if isAdmin(); allow create: if signedIn(); }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin() || request.auth.uid == uid;
    }
  }
}
